#!/usr/bin/env bash
set -e

# Copies plugin Kotlin sources into the Android project generated by Capacitor
ROOT_DIR=$(pwd)
ANDROID_APP_DIR="$ROOT_DIR/android/app/src/main/java/com/nac/choir"

mkdir -p "$ANDROID_APP_DIR/audio"
cp -R "$ROOT_DIR/plugins/capacitor-android-audio/src/audio/"* "$ANDROID_APP_DIR/audio/" || true
cp -R "$ROOT_DIR/plugins/capacitor-android-audio/src/CapacitorAudioPlugin.kt" "$ANDROID_APP_DIR/" || true

echo "Plugin files copied to $ANDROID_APP_DIR"
