export async function start(url: string, title = 'NAC', text = 'Playing') {
  // Capacitor v5 plugin access pattern may vary; this is a generic call
  // If using Capacitor 5, replace with generated plugin import
  try {
    // @ts-ignore
    const { NacAudio } = (window as any).Capacitor?.Plugins || (await import('@capacitor/core')).Plugins
    return await NacAudio.start({ url, title, text })
  } catch (e) {
    console.error('NacAudio.start error', e)
    throw e
  }
}

